# Sample environment file for the Smart Subtitle Converter API.
#
# Copy what you need. Unset variables keep the defaults shown here.
# Empty allowlists mean that scheme is off: filesystem URIs need roots,
# S3 URIs need buckets, HTTPS URIs need hosts.
# Do not put real keys in a file you commit. Credentials stay in the
# environment or the task/instance role, never in a request body.

# -----------------------------------------------------------------------------
# Listening
# -----------------------------------------------------------------------------

# Port inside the container. Compose publishes it as 127.0.0.1:8080:8080
# (change the host side if 8080 is already taken).
ASPNETCORE_HTTP_PORTS=8080

# Folder of mounted presets. Override a built-in preset by placing a file
# with the same name here; the folder is re-scanned when its mtime changes.
PROFILES_DIR=/profiles

# -----------------------------------------------------------------------------
# Auth and errors
# -----------------------------------------------------------------------------

# Comma-separated bearer keys (name:key is allowed). Unset means auth is off.
# API_KEYS=

# One key per line, # comments, name:key. Reloaded when the file changes.
# Prefer this over API_KEYS in Compose (mount the file).
# API_KEYS_FILE=/keys/api-keys.txt

# When false, stack traces and internals are stripped from error responses.
ERRORS_VERBOSE=true

# -----------------------------------------------------------------------------
# Size and conversion limits
# -----------------------------------------------------------------------------

# Max decoded subtitle size in bytes (10 MiB). Body caps are derived from this:
# multipart is this plus 256 KiB of framing; JSON is base64 of this plus the
# profile cap plus 64 KiB. See GET /v1/limits.
MAX_UPLOAD_BYTES=10485760

# Max inline profile JSON in a request (minimum 1024).
PROFILE_MAX_BYTES=65536

# Waiting conversions before the API answers 503 queue-full.
# libse keeps settings in global state, so one worker runs one conversion
# at a time. Scale out with replicas.
QUEUE_CAPACITY=32

# Queue-wait budget and run budget for libse, each, in seconds.
# This clock covers conversion only, not download or upload.
CONVERSION_TIMEOUT_SECONDS=30

# Input limits.
MAX_CUES=200000
MAX_LINE_CHARS=10000

# -----------------------------------------------------------------------------
# Jobs (in-memory only; a restart clears them on purpose)
# -----------------------------------------------------------------------------

# How long the HTTP request waits for the conversion to finish before
# returning 202 Accepted with Location: /v1/jobs/{id} and Retry-After.
# Callers can override with Prefer: wait=N (seconds). Prefer: wait=0
# returns the id immediately. This is how long we block the caller, not
# how long the job may run; retries can continue after a 202. Range: 0..60.
REQUEST_WAIT_SECONDS=30

# How long a finished (or running) job record is kept so GET /v1/jobs/{id}
# still works, including after a synchronous 200. Counted from creation.
# Seconds, range 1..86400. 21600 = 6 hours.
JOB_TTL_SECONDS=21600

# Hard cap on in-memory job records. Oldest entries are evicted first so a
# burst of requests cannot grow memory without bound. Records hold metadata
# only (id, status, timestamps, URIs, verification, warnings, error), never
# the subtitle bytes. File routes re-read stored URIs, not a cached copy. Range 1..10000. Active work is separately capped at
# min(JOB_MAX_ENTRIES, QUEUE_CAPACITY + 1). Metadata budget: 128 KiB/job result.
JOB_MAX_ENTRIES=400

# -----------------------------------------------------------------------------
# Remote I/O (S3-compatible and HTTPS)
# -----------------------------------------------------------------------------

# Per-attempt timeout for a download or upload, in seconds. Keep this
# shorter than REQUEST_WAIT_SECONDS so one stuck call does not burn the
# whole wait. Range: 1..300.
IO_TIMEOUT_SECONDS=10

# Extra attempts after a transient I/O failure (timeout, connection reset,
# 429, 503). 404, 403, SSRF rejections and validation errors are not retried.
# Range: 0..10 extra attempts.
IO_RETRIES=3

# -----------------------------------------------------------------------------
# Filesystem locations
# -----------------------------------------------------------------------------
# URIs: file:///data/in/show.stl  or a bare absolute path  /data/in/show.stl
# The host (or Compose) mounts the real storage at these roots. The API
# never speaks NFS, SMB, Aspera or Signiant; it only reads and writes
# inside the mount.
#
# Empty means filesystem URIs are rejected. Paths are canonicalized;
# ".." and all symlinks are rejected. Linux server only; parents must exist.
# Existing filesystem destinations are rejected, not overwritten.

# Colon-separated absolute Linux paths, or a JSON array.
# STORAGE_FILE_ROOTS=["/data/in","/data/out"]
# STORAGE_FILE_ROOTS=/data

# When true, filesystem destinations write to a sibling temp file and
# rename into place. Off by default: a caller waiting for our HTTP
# response already knows when the write finished, and some network
# mounts make rename unreliable. Turn on if another process scans the
# folder while we write.
STORAGE_FILE_ATOMIC=false

# -----------------------------------------------------------------------------
# S3-compatible locations (AWS, MinIO, Wasabi, Backblaze, and similar)
# -----------------------------------------------------------------------------
# URIs: s3://bucket/key
# Not Azure Blob or GCS. Use the official AWS SDK against a custom
# endpoint when you are not on AWS.

# Custom endpoint (MinIO and other S3-compatible stores). Unset means
# the AWS default.
# S3_ENDPOINT=https://minio.internal:9000

# Signing region. Many MinIO setups accept us-east-1.
# S3_REGION=us-east-1

# S3 writes default to conditional create (If-None-Match: *); ifExists=replace
# on a request explicitly allows replacement. HTTPS PUT follows its signer policy.
# Path-style URLs (https://endpoint/bucket/key). Typically true for MinIO.
S3_FORCE_PATH_STYLE=false

# Comma-separated bucket names. Empty means S3 URIs are rejected.
# S3_ALLOWED_BUCKETS=subs,tmp

# Optional comma-separated key prefixes allowed inside those buckets
# (for example in/,out/). Unset means any key in an allowlisted bucket.
# S3_ALLOWED_PREFIXES=in/,out/

# Credentials: the default AWS chain (environment, shared config, or
# task/instance role). Do not put real keys in a committed file. Required
# IAM actions and a minimal policy: docs/deployment.md#s3-permissions.
# Startup logs show the resolved source with keys masked (AKI***MPLE).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# HTTPS locations
# -----------------------------------------------------------------------------
# Input: GET an allowlisted or presigned https:// URL.
# Output: PUT the converted file to an allowlisted or presigned https:// URL
# (same host rules). Sidecars are skipped for HTTPS output, with a warning.
#
# Tight SSRF rules: HTTPS only, host must match the allowlist, link-local,
# loopback and cloud metadata addresses (including 169.254.169.254) are
# blocked (also private/reserved addresses), and MAX_UPLOAD_BYTES is enforced. Content-Type
# is not trusted.

# Comma-separated hostnames (no scheme). Empty means HTTPS URIs are rejected.
# Include your S3 or MinIO host here if you use presigned https:// URLs
# rather than s3:// URIs.
# HTTP_ALLOWED_HOSTS=mam.example.com,store.example.com
# Private IPs are blocked even for allowlisted hosts; use s3:// for internal MinIO.

# -----------------------------------------------------------------------------
# HTTP extras
# -----------------------------------------------------------------------------

# Comma-separated browser origins. Unset means CORS is off.
# CORS_ORIGINS=https://studio.example.com

# Proxy IPs whose X-Forwarded-* headers are trusted.
# KNOWN_PROXIES=10.0.0.1

# Per key name, or per client IP when auth is off. 0 (or unset) means off.
RATE_LIMIT_PER_MINUTE=0

# Scalar UI at /docs.
DOCS_ENABLED=true

# Prometheus text at /metrics. Optionally bind metrics to METRICS_PORT only.
METRICS_ENABLED=false
# METRICS_PORT=9090

