# Smart Subtitle Converter API: sample settings.
# Quick start (the container runs as UID 1654 and must be able to write the key file):
#   cp .env.example .env && touch api_keys.txt && chmod 600 api_keys.txt && sudo chown 1654 api_keys.txt
#   docker compose up -d
# The first start writes an API key into api_keys.txt (it is never printed).
# Every line below shows its default, so you only edit what you need.
# Settings without a default are commented out: remove the # to use them.
# Never commit real keys or secrets.

# =============================================================================
# 1. Network and access
# =============================================================================

# Docker image to run (docker-compose.yml only).
API_IMAGE=ghcr.io/wauter/smart-subtitle-converter-api:edge

# Where the host publishes the API (docker-compose.yml only).
# 127.0.0.1 is this machine only; 0.0.0.0 is every interface (read docs/security.md first).
PUBLISH_ADDRESS=127.0.0.1
PUBLISH_PORT=8080

# Host names the API answers to, comma-separated, no ports. localhost, 127.0.0.1
# and [::1] are always allowed. Keep the Compose service name if other containers
# call the API by it; add names such as host.orb.internal or your proxy's name.
ALLOWED_HOSTS=smart-subtitle-converter-api

# =============================================================================
# 2. Authentication
# =============================================================================
# Every /v1 request needs "Authorization: Bearer <key>".
# /healthz, /readyz, /metrics, /docs and /openapi/v1.json stay open.
# Keys come from api_keys.txt (mounted by docker-compose.yml: one key per line,
# optional name:key; an empty file gets a generated key on first start) and from API_KEYS.

# Extra comma-separated keys (name:key is allowed).
API_KEYS=

# Turns authentication off. Throwaway local tests only.
API_AUTH_DISABLED=false

# =============================================================================
# 3. Storage locations
# =============================================================================
# The API reads and writes files only inside the locations you allow here.
# Anything left empty is off: its URIs are rejected.

# --- Local folders (file:///data/in/show.srt or /data/in/show.srt) ---
# Mount the folder in docker-compose.yml first (./data:/data, writable by UID 1654).
# Absolute container paths, colon-separated or a JSON array: /data  or  ["/data/in","/data/out"]
STORAGE_FILE_ROOTS=

# Write to a temp file, then rename into place. Turn on if another process scans the folder.
STORAGE_FILE_ATOMIC=false

# --- S3-compatible storage (s3://bucket/key): AWS, MinIO, Wasabi, Backblaze ---
# Allowed buckets, comma-separated.
S3_ALLOWED_BUCKETS=

# Optional key prefixes allowed inside those buckets, e.g. in/,out/. Empty means any key.
S3_ALLOWED_PREFIXES=

# Endpoint for MinIO and other non-AWS stores, e.g. https://minio.internal:9000. Empty means AWS.
S3_ENDPOINT=

S3_REGION=us-east-1

# true for MinIO and other path-style endpoints, false for AWS.
S3_FORCE_PATH_STYLE=false

# Credentials come from the default AWS chain (variables, shared config or an IAM role).
# Permissions needed: docs/deployment.md#s3-permissions
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only for temporary keys (ids starting with ASIA).
# AWS_SESSION_TOKEN=
# Or a named profile from a mounted credentials file (for example ~/.aws:/aws:ro).
# AWS_PROFILE=default
# AWS_SHARED_CREDENTIALS_FILE=/aws/credentials
# AWS_CONFIG_FILE=/aws/config

# --- HTTPS (allowlisted or presigned https:// URLs) ---
# Allowed host names, comma-separated, no scheme. Add your S3 host here to use presigned URLs.
# Private, loopback and cloud-metadata addresses stay blocked. Use s3:// for an internal MinIO.
HTTP_ALLOWED_HOSTS=

# --- Browsing and reading by location ---
# Lets clients list the allowed folders and buckets and read files by location
# (GET /v1/storage/locations, /list and /file). false answers 403 storage-list-disabled.
STORAGE_LIST_ENABLED=true

# =============================================================================
# 4. Size and conversion limits
# =============================================================================

# Max decoded subtitle size in bytes (10 MiB).
MAX_UPLOAD_BYTES=10485760

# Max inline profile JSON in a request (minimum 1024).
PROFILE_MAX_BYTES=65536

# Waiting conversions before the API answers 503 queue-full. One worker runs one
# conversion at a time; scale out with replicas.
QUEUE_CAPACITY=32

# Queue-wait budget and run budget for a conversion, each, in seconds (not download or upload).
CONVERSION_TIMEOUT_SECONDS=30

# A conversion past its budget blocks new ones (503 conversion-engine-stuck, /readyz not ready).
# If it is still running after this grace period the process exits with code 70 and the
# restart policy starts a clean one. 0 means 2 x CONVERSION_TIMEOUT_SECONDS.
CONVERSION_STUCK_GRACE_SECONDS=0

MAX_CUES=200000
MAX_LINE_CHARS=10000

# =============================================================================
# 5. Jobs (in memory; a restart clears them)
# =============================================================================

# Seconds a request waits before answering 202 Accepted with Location: /v1/jobs/{id}.
# Callers can override with Prefer: wait=N. Range 0..60.
REQUEST_WAIT_SECONDS=30

# Seconds a job record is kept, counted from creation. Range 1..86400 (21600 = 6 hours).
JOB_TTL_SECONDS=21600

# Max job records kept; the oldest are dropped first. Range 1..10000.
JOB_MAX_ENTRIES=400

# =============================================================================
# 6. Remote I/O (S3 and HTTPS)
# =============================================================================

# Per-attempt timeout for a download or upload, in seconds. Range 1..300.
IO_TIMEOUT_SECONDS=10

# Extra attempts after a transient failure (timeout, reset, 429, 503). Range 0..10.
IO_RETRIES=3

# =============================================================================
# 7. Browse queue
# =============================================================================
# Listing, reading by location and job file reads have their own queue, separate
# from conversions: this many run at once, this many more wait up to
# BROWSE_WAIT_SECONDS, beyond that 503 browse-busy.
BROWSE_CONCURRENCY=4
BROWSE_QUEUE_CAPACITY=32
BROWSE_WAIT_SECONDS=30

# =============================================================================
# 8. HTTP, logging and errors
# =============================================================================

# Proxy IPs whose X-Forwarded-* headers are trusted, comma-separated.
KNOWN_PROXIES=

# Requests per minute per key (per client IP when auth is off). 0 means off.
RATE_LIMIT_PER_MINUTE=0

# Interactive API docs at /docs.
DOCS_ENABLED=true

# Console log format: text or json.
LOG_FORMAT=text

# Prometheus metrics at /metrics; optionally serve them on METRICS_PORT only.
METRICS_ENABLED=false
# METRICS_PORT=9090

# Include stack traces and internals in error responses. Details always go to the
# server log under the same requestId.
ERRORS_VERBOSE=false

# Running the image without docker-compose.yml? Also set API_KEYS_FILE, PROFILES_DIR
# and ASPNETCORE_HTTP_PORTS (see docs/deployment.md).
