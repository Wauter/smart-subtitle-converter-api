{
  "openapi": "3.1.1",
  "info": {
    "title": "Subtitle Edit Converter API",
    "description": "Convert subtitles between text formats with Subtitle Edit\u0027s libse. Errors are RFC 7807 problem\u002Bjson with a stable \u0060code\u0060, a \u0060hint\u0060 and the \u0060requestId\u0060. Send \u0060Authorization: Bearer \u003Ckey\u003E\u0060 when API keys are configured.",
    "version": "1.0.0"
  },
  "servers": null,
  "paths": {
    "/v1/convert": {
      "post": {
        "tags": [
          "convert"
        ],
        "summary": "Convert a subtitle file (multipart upload).",
        "description": "Upload \u0060file\u0060 with \u0060preset\u0060, \u0060target\u0060 and/or \u0060profile\u0060 (JSON overrides). A zip upload converts every entry and returns a zip with manifest.json. Response headers report detected format/encoding, cue counts and warnings.",
        "operationId": "convert",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "The subtitle file, or a zip of subtitle files.",
                    "format": "binary"
                  },
                  "preset": {
                    "type": "string",
                    "description": "Preset name (GET /v1/profiles)."
                  },
                  "target": {
                    "type": "string",
                    "description": "Target format id/alias; shorthand for profile.target.format."
                  },
                  "profile": {
                    "type": "string",
                    "description": "Profile JSON (full profile or overrides on top of preset). Schema: GET /v1/schemas/profile.json."
                  },
                  "failFast": {
                    "type": "string",
                    "description": "Zip input only: \u0027true\u0027 stops at the first failing entry instead of reporting it in manifest.json."
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/convert/json": {
      "post": {
        "tags": [
          "convert"
        ],
        "summary": "Convert subtitle content sent as JSON (for agents).",
        "description": "Send \u0060content\u0060 as text (or base64 with contentEncoding=base64). Outputs come back as text for Unicode encodings, base64 otherwise.",
        "operationId": "convertJson",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConvertJsonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConvertJsonResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/formats": {
      "get": {
        "tags": [
          "formats"
        ],
        "summary": "List subtitle formats.",
        "description": "Use \u0060id\u0060 or an alias as source/target format. \u0060textOnly\u0060 defaults to true; V1 can only convert text formats.",
        "operationId": "listFormats",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "textOnly",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FormatInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/detect": {
      "post": {
        "tags": [
          "formats"
        ],
        "summary": "Detect the format and encoding of a subtitle.",
        "description": "Send multipart \u0060file\u0060, or JSON {content, contentEncoding, fileName}. 422 format-not-detected when nothing matches.",
        "operationId": "detect",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "The subtitle file, or a zip of subtitle files.",
                    "format": "binary"
                  },
                  "encoding": {
                    "type": "string",
                    "description": "Optional: force the input encoding."
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "required": [
                  "content"
                ],
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "description": "Subtitle content (text, or base64)."
                  },
                  "contentEncoding": {
                    "type": "string",
                    "description": "text (default) | base64"
                  },
                  "fileName": {
                    "type": "string",
                    "description": "Optional file name (helps detection)."
                  },
                  "encoding": {
                    "type": "string",
                    "description": "Optional: force the input encoding."
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectedInfo"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profiles": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "List built-in and mounted presets, including invalid ones with their errors.",
        "operationId": "listProfiles",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfilesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profiles/{name}": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "Get one preset: raw JSON, resolved (extends flattened) profile and errors.",
        "operationId": "getProfile",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresetDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profiles/validate": {
      "post": {
        "tags": [
          "profiles"
        ],
        "summary": "Validate a profile without converting.",
        "description": "Always 200 for a JSON object: \u0060valid\u0060, \u0060errors\u0060 (JSON pointer \u002B hint), \u0060warnings\u0060 and the resolved profile. 400 only for unparseable JSON.",
        "operationId": "validateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "A profile. JSON Schema: GET /v1/schemas/profile.json"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/schemas/profile.json": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "JSON Schema (2020-12) for profiles.",
        "operationId": "profileSchema",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
