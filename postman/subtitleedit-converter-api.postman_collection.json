{
  "info": {
    "_postman_id": "48b0adfa-e493-5b61-a071-2cf7c7caee01",
    "name": "subtitleedit-converter-api",
    "description": "Every subtitleedit-converter-api endpoint with the README examples, plus negative cases.\n\nSet `baseUrl` (default http://localhost:8080) and `apiKey` (leave empty for an open server) in the environment. File parts use paths relative to the repository root: in Postman set Settings -> General -> Working directory to your checkout; with newman pass `--working-dir <checkout>`.\n\nEvery request sends `Authorization: Bearer {{apiKey}}` when apiKey is set, except those tagged [no auth].",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const key = pm.environment.get('apiKey') || pm.collectionVariables.get('apiKey');",
          "if (key && !pm.info.requestName.includes('[no auth]') && !pm.request.headers.has('Authorization'))",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + key });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('X-Request-Id present', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
          "pm.test('X-Content-Type-Options nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Liveness probe. Always open, even with API keys on."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readyz"
              ]
            },
            "description": "Readiness: startup self-test (SRT->WebVTT), Skia, ICU/globalization probes, worker, queue. 503 + `failing` when not ready."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"ready\", () => pm.expect(j.status).to.eql(\"ready\"));",
                  "pm.test(\"all checks ok\", () => Object.entries(j.checks).forEach(([k, v]) => pm.expect(v, k).to.eql(\"ok\")));",
                  "pm.test(\"globalization check present\", () => pm.expect(j.checks).to.have.property(\"globalization\"));"
                ]
              }
            }
          ]
        }
      ]
    },
