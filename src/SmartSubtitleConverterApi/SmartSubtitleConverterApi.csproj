<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.4.0</Version>
    <Product>Smart Subtitle Converter API</Product>
    <Title>Smart Subtitle Converter API</Title>
    <AssemblyName>SmartSubtitleConverterApi</AssemblyName>
    <RootNamespace>SmartSubtitleConverterApi</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LibseVersion>5.1.0</LibseVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- libse is pinned. Bump together with SkiaSharp.NativeAssets.Linux.NoDependencies (docs/design.md §8). -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.10" />
    <PackageReference Include="libse" Version="$(LibseVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="presets/*.json" LogicalName="preset:%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LibseVersion" Value="$(LibseVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartSubtitleConverterApi.Tests" />
  </ItemGroup>

</Project>
